# Required: demo uses browser-only fixture state; production uses PostgreSQL and fails closed.
EDITOR_CONSOLE_MODE=production

# Stable editor identifier recorded on drafts and immutable submissions.
EDITOR_IDENTITY=vaughan-brief-editor

# Production only. Never prefix this server-only variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Production only: the console login. With either missing, every request is refused.
# Changing either one signs everyone out.
CONSOLE_AUTH_USER=editor
CONSOLE_AUTH_PASSWORD=change-me
