    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// R2 v1: Rules-first classification with gap-score confidence.\n// Outputs: SegmentSuggested, SegmentConfidence, NeedsReview, plus debug fields.\n\nconst SEGMENTS = [\n  { key: 'Local Aroma', strong: ['grand opening','now open','new opening','tasting menu','chef','food festival','restaurant week','cooking class','baking class','espresso class','culinary'], weak: ['cafe','café','coffee','espresso','latte','bakery','brunch','market','pop-up','popup','recipe','cook','bake'] },\n  { key: 'For Families', strong: ['kids','kid-friendly','family','children','toddler','storytime','march break','pa day','camp'], weak: ['craft','museum','workshop','all ages','play','sensory','face painting'] },\n  { key: 'For Golden Age Readers', strong: ['seniors','senior','55+','60+','65+','retirement','retired'], weak: ['community centre','daytime','lecture','walking','social','wellness'] },\n  { key: 'For Couples', strong: ['date night','valentine','wine tasting','cocktail','live music','comedy show','theatre','theater','candle making'], weak: ['concert','show','karaoke','trivia','paint night','sip and paint','night out'] },\n];\n\nfunction norm(s) {\n  return (s || '').toString().toLowerCase();\n}\n\nfunction countHits(text, phrases) {\n  let hits = 0;\n  for (const p of phrases) {\n    if (!p) continue;\n    if (text.includes(p)) hits += 1;\n  }\n  return hits;\n}\n\nconst title = $json['Event Title'] || $json.title || '';\nconst desc  = $json['DescriptionRaw'] || $json['Short Description'] || $json.description || '';\nconst venue = $json['Venue'] || $json['LocationName'] || '';\nconst source = $json['Source'] || $json.source || '';\n\nconst text = norm(`${title} ${desc} ${venue} ${source}`);\n\nconst businessBad = ['realtor','commission','mortgage','tax','cra','insurance','sales training','webinar','networking'];\nconst isBusinessy = businessBad.some(w => text.includes(w));\n\nconst scores = [];\n\nfor (const seg of SEGMENTS) {\n  const strongHits = countHits(text, seg.strong);\n  const weakHits = countHits(text, seg.weak);\n  let score = strongHits * 2 + weakHits;\n  scores.push({ segment: seg.key, score, strongHits, weakHits });\n}\n\nscores.sort((a,b) => b.score - a.score);\n\nconst top = scores[0];\nconst second = scores[1] || { score: 0 };\nconst topScore = top.score;\nconst gap = top.score - second.score;\n\nlet accept = false;\nif (topScore >= 2) accept = (gap >= 0);\n\nconst SegmentSuggested = accept ? top.segment : null;\nconst SegmentConfidence = Math.max(0, Math.min(1, gap / 4));\nconst NeedsReview = !accept;\nconst R2Status = NeedsReview ? 'NeedsReview' : 'Enriched';\n\nreturn {\n  json: {\n    ...$json,\n    SegmentSuggested,\n    SegmentConfidence,\n    NeedsReview,\n    R2Status,\n    _r2_topSegment: top.segment,\n    _r2_topScore: topScore,\n    _r2_gap: gap,\n    _r2_scores: scores\n  }\n};"
      },
