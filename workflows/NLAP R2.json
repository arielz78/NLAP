    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw =\n  $json.output?.[0]?.content?.[0]?.text ??\n  $json.text ??\n  $json.response ??\n  $json.data ??\n  $json.output ??\n  $json.body ??\n  null;\n\nlet parsed = {};\nlet parseError = null;\n\nif (typeof raw === 'string') {\n  try {\n    parsed = JSON.parse(raw.trim());\n  } catch (e) {\n    parseError = \"JSON parse failed: \" + e.message;\n  }\n} else if (typeof raw === 'object' && raw !== null) {\n  parsed = raw;\n} else {\n  parseError = \"No usable output from model\";\n}\n\nconst validSegments = [\n  \"For Families\",\n  \"For Couples\",\n  \"For Golden Age Readers\",\n  \"Local Aroma\",\n  \"Trust Me Recipe\"\n];\n\nconst segment = parsed.segment ?? null;\nconst validatedSegment = validSegments.includes(segment) ? segment : null;\n\nif (!parseError && validatedSegment === null) {\n  parseError = \"Invalid or empty segment: \" + JSON.stringify(segment);\n}\n\nreturn {\n  json: {\n    id: $('Filter').item.json.id,\n    LLM_SegmentSuggested: validatedSegment,\n    LLM_Confidence: parsed.confidence ?? null,\n    LLM_Rationale: parsed.reason ?? null,\n    LLM_ParseError: parseError,\n    NeedsReview:\n      validatedSegment === null || (parsed.confidence ?? 0) < 0.5\n  }\n};"
      },
