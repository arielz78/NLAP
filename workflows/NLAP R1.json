      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const DAYS_AHEAD = 30;\n\nconst today = new Date();\nconst startOfToday = new Date(today.getFullYear(), today.getMonth(), today.getDate());\nconst endDate = new Date(startOfToday);\nendDate.setDate(endDate.getDate() + DAYS_AHEAD);\n\nconst startRaw = $json.start_date || $json.isoDate || '';\n\nif (!startRaw) {\n  return null; // drop if no date\n}\n\nconst eventDate = new Date(startRaw);\nif (isNaN(eventDate.getTime())) {\n  return null; // drop invalid date\n}\n\nconst eventDateOnly = new Date(eventDate.getFullYear(), eventDate.getMonth(), eventDate.getDate());\n\nif (eventDateOnly < startOfToday) {\n  return null; // drop past events\n}\n\nif (eventDateOnly > endDate) {\n  return null; // drop too far in future\n}\n\nreturn $json;"
      },
