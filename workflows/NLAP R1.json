      "id": "afa1c2eb-2646-4766-b832-ec9dcc9e7a31",
      "name": "Clean/Filter"
    },
    {
      "parameters": {
        "jsCode": "// Sort items newest → oldest based on isoDate or pubDate\nfunction toTs(x) {\n  if (!x) return 0;\n  const d = new Date(x);\n  return isNaN(d.getTime()) ? 0 : d.getTime();\n}\n\nconst arr = items.map(i => i);\narr.sort((a, b) => {\n  const A = toTs(a.json.isoDate || a.json.pubDate);\n  const B = toTs(b.json.isoDate || b.json.pubDate);\n  return B - A;\n});\n\nreturn arr;\n"
      },
