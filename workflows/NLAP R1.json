    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// NORMALIZATION_VERSION: v2 (2026-06-07)\n// Adds: HTML entity decoding, curly-quote/dash/space/ellipsis -> ASCII mapping, NFC normalization.\n// Any future change to this block requires re-running scripts/updateUniqueEventIDs.js\n// to backfill all existing Candidates records, otherwise old and new IDs will mismatch.\n\nfunction decodeEntities(s) {\n  return s\n    .replace(/&#(\\d+);/g, (_, n) => String.fromCodePoint(parseInt(n, 10)))\n    .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n, 16)))\n    .replace(/&amp;/g, \"&\")\n    .replace(/&apos;/g, \"'\")\n    .replace(/&quot;/g, '\"')\n    .replace(/&lt;/g, \"<\")\n    .replace(/&gt;/g, \">\");\n}\nfunction straighten(s) {\n  return s\n    .replace(/[‘’‚‛]/g, \"'\")\n    .replace(/[“”„‟]/g, '\"')\n    .replace(/[–—−]/g, \"-\")\n    .replace(/[  -  ]/g, \" \")\n    .replace(/…/g, \"...\");\n}\nfunction norm(s) {\n  return straighten(decodeEntities((s || \"\").toString()))\n    .normalize(\"NFC\")\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, \" \");\n}\nfunction dateOnly(d) {\n  const dt = new Date(d);\n  if (isNaN(dt.getTime())) return \"\";\n  return dt.toISOString().slice(0, 10);\n}\nconst rawTitle = $json.title || $json.event_name || \"\";\nconst titleNorm = norm(rawTitle);\nconst link =\n  $json.link ||\n  $json.url ||\n  $json.linkUrl ||\n  $json.link_url ||\n  \"\";\nconst day = dateOnly($json.isoDate || $json.pubDate);\nconst hasUrl = !!link;\nconst hasDate = !!day;\nreturn {\n  ...$json,\n  event_name: rawTitle,\n  url: link,\n  start_date: day,\n  uniqueEventID: `${titleNorm}|${day}`,\n  city: \"Vaughan\",\n  _valid: hasUrl && hasDate,\n  _invalid_reason: !hasUrl ? \"missing_url\" : (!hasDate ? \"missing_date\" : \"\"),\n};"
      },
